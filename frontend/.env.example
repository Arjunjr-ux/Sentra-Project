# Sentra frontend — environment variables.
# Copy to .env.local for local development. Vite only exposes vars prefixed VITE_.

# Full base URL of the API, including the /api/v1 path.
# On Render this may arrive as just the API hostname; the client prepends
# https:// and appends /api/v1 when they're missing.
VITE_API_URL=http://localhost:8000/api/v1
