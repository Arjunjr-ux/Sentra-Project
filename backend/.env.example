# Sentra backend — environment variables.
# Copy to .env for local development. Never commit .env.

# Django core
SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Omit for local SQLite (default), or point at Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/sentra
DATABASE_URL=

# Frontend origin(s) allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
